datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Schedule {
  id           String   @id @default(uuid())
  tenantId     String
  employeeId   String
  employeeName String
  date         DateTime
  shiftStart   DateTime
  shiftEnd     DateTime
  createdAt    DateTime @default(now())
}

model Attendance {
  id           String    @id @default(uuid())
  tenantId     String
  employeeId   String
  employeeName String
  clockIn      DateTime  @default(now())
  clockOut     DateTime?
  hoursWorked  Float?
  status       String    @default("PRESENT")
}

model Payroll {
  id           String   @id @default(uuid())
  tenantId     String
  employeeId   String
  employeeName String
  monthYear    String
  baseSalary   Float
  allowances   Float    @default(0)
  deductions   Float    @default(0)
  netPay       Float
  generatedAt  DateTime @default(now())
  payslipUrl   String?
}
