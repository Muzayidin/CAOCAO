datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Shift {
  id            String    @id @default(uuid())
  tenantId      String
  cashierId     String
  cashierName   String
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  startCapital  Float
  expectedCash  Float?
  actualCash    Float?
  discrepancy   Float?
  status        String    @default("OPEN")
  notes         String?
}
